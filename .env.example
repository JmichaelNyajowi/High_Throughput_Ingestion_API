# Never commit a populated .env file.
POSTGRES_DB=telemetry
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=replace-with-a-local-development-secret
POSTGRES_URL=postgres://telemetry:replace-with-a-local-development-secret@localhost:5432/telemetry?sslmode=disable
REDIS_URL=redis://:replace-with-a-local-development-secret@localhost:6379/0
REDIS_PASSWORD=replace-with-a-local-development-secret
API_LISTEN_ADDR=:8080
APP_ENV=development
API_READ_HEADER_TIMEOUT=5s
API_READ_TIMEOUT=10s
API_WRITE_TIMEOUT=15s
API_IDLE_TIMEOUT=60s
API_POSTGRES_TIMEOUT=2s
API_REDIS_TIMEOUT=2s
API_SHUTDOWN_TIMEOUT=10s
CADDY_SITE_ADDRESS=:80
CADDY_BASIC_AUTH_HASH=replace-with-a-caddy-password-hash
TELEMETRY_API_KEY_PEPPER=replace-with-a-32-byte-or-longer-random-secret
TELEMETRY_DEVICE_SEEDS=[]
