{$CADDY_SITE_ADDRESS} {
  encode zstd gzip

  @device path /v1/telemetry/batches
  handle @device {
    reverse_proxy api:8080
  }

  @health path /healthz /readyz
  handle @health {
    reverse_proxy api:8080
  }

  basicauth {
    operator {$CADDY_BASIC_AUTH_HASH}
  }

  @operator path /v1/live/* /v1/history/*
  handle @operator {
    reverse_proxy api:8080
  }

  root * /srv
  try_files {path} /index.html
  file_server
}
