{$CADDY_SITE_ADDRESS} {
  encode zstd gzip
  header ?X-Request-ID {http.request.uuid}

  @device path /v1/telemetry/batches
  handle @device {
    reverse_proxy api:8080
  }

  @observability path /healthz /readyz /metrics
  handle @observability {
    respond "Forbidden" 403
  }

  @operator {
    path /v1/live/* /v1/history/*
  }
  handle @operator {
    @operator-private {
      remote_ip private_ranges
    }
    handle @operator-private {
      basic_auth {
        operator {$CADDY_BASIC_AUTH_HASH}
      }
      reverse_proxy api:8080
    }
    handle {
      respond "Forbidden" 403
    }
  }

  @dashboard-private {
    not path /v1/* /healthz /readyz /metrics
    remote_ip private_ranges
  }
  handle @dashboard-private {
    basic_auth {
      operator {$CADDY_BASIC_AUTH_HASH}
    }
    root * /srv
    try_files {path} /index.html
    file_server
  }

  handle {
    respond "Forbidden" 403
  }
}
